# Node Environment
NODE_ENV=development

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost
CORS_ORIGIN=http://localhost

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spookify_db
DB_USER=spookify_user
DB_PASSWORD=spookify_password
DATABASE_URL=postgresql://spookify_user:spookify_password@localhost:5432/spookify_db

# Spotify OAuth
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost/api/auth/callback

# JWT
JWT_SECRET=spookiefy_super_secret_key_change_me
